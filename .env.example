# Database Configuration
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/school_management"

# Dedicated application user example (least-privileged access):
# DATABASE_URL="mysql://sms_app:AppUserSecurePassword123!@localhost:3306/school_management"

# Test Database for isolated security testing & backup/restore verification:
TEST_DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/school_management_test"

# Application Settings
NODE_ENV="development"
PORT=3000

# Authentication & Security
AUTH_SECRET="your-super-secret-jwt-or-session-key-change-this-in-production"
AUTH_SALT_ROUNDS=10
